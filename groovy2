import javax.jcr.Node
import javax.jcr.NodeIterator
import javax.jcr.Property
import javax.jcr.Session

def resourceResolver = resourceResolver
Session session = resourceResolver.adaptTo(Session.class)

String indexPath = "/oak:index/damAssetLucene"

if (!session.itemExists(indexPath)) {
    println "Index not found at ${indexPath}"
    return
}

Node indexNode = session.getNode(indexPath)
println "Scanning index: ${indexPath}"
println "=========================================="

List<String> suggestProps = []

// Recursively walk the index tree looking for nodes that have a
// "useInSuggest" property set to true (these live under
// indexRules/<nodeType>/properties/<propName>)
def walk
walk = { Node node, String path ->
    if (node.hasProperty("useInSuggest")) {
        Property prop = node.getProperty("useInSuggest")
        boolean value = prop.getBoolean()
        if (value) {
            // try to get the actual property name being indexed, if present
            String indexedPropName = node.hasProperty("name") ? node.getProperty("name").getString() : node.getName()
            suggestProps.add("${path}  (indexes property: ${indexedPropName})")
        }
    }

    NodeIterator children = node.getNodes()
    while (children.hasNext()) {
        Node child = children.nextNode()
        walk(child, "${path}/${child.getName()}")
    }
}

walk(indexNode, indexPath)

println "Properties with useInSuggest = true:"
println "--------------------------------------------"
if (suggestProps.isEmpty()) {
    println "  None found."
} else {
    suggestProps.each { println "  ${it}" }
}

println "=========================================="
println "Total found: ${suggestProps.size()}"
